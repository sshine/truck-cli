# Re-evaluate when a local module or the flake changes.
#
# The guard keeps the first run quiet, and the loop picks up modules that later
# phases add (hooks, binary pins) without editing this file again. In IFD mode the
# crate2nix helper modules are absent; the loop simply stops watching them.
for f in flake.nix nix/*.nix; do
  if [ -e "$f" ]; then
    watch_file "$f"
  fi
done

use flake
